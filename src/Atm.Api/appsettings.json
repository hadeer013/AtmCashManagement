{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AtmDb": "Server=(localdb)\\MSSQLLocalDB;Database=AtmCashManagement;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Atm": {
    "QuoteTimeToLiveSeconds": 60,
    "DailyLimits": {
      "TRY": 20000,
      "USD": 1000,
      "EUR": 1000
    },
    "ReconciliationApprovalThresholdTry": 1000,
    "BusinessTimeZone": "Europe/Istanbul"
  },
  "CardHashing": {
    "Secret": "local-development-secret-change-me"
  },
  "BackgroundJobs": {
    "Enabled": true,
    "OutboxPollIntervalMilliseconds": 2000,
    "OutboxBatchSize": 50,
    "QuoteExpiryPollIntervalMilliseconds": 5000
  }
}
